<Project Sdk="Microsoft.NET.Sdk">
  <!-- Props/targets are automatically imported by NuGet, but here we need to do it manually. -->
  <!-- This needs to be done before any other props or targets, to match NuGet's behavior. -->
  <Import Project="../Snek/Snek.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpier.MSBuild" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Snek/Snek.csproj" />
  </ItemGroup>

  <!-- Props/targets are automatically imported by NuGet, but here we need to do it manually. -->
  <!-- This needs to be done after everything else, to match NuGet's behavior. -->
  <!-- Since we're referencing the project directly rather than through the packed NuGet -->
  <!-- package, point the task loader at the project's own build output instead of `tasks/`. -->
  <PropertyGroup>
    <SnekTasksDirectory>$(MSBuildThisFileDirectory)../Snek/bin/$(Configuration)/</SnekTasksDirectory>
  </PropertyGroup>
  <Import Project="../Snek/Snek.targets" />
</Project>
